# Core
ENVIRONMENT=production
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
FRONTEND_URL=https://your-app.vercel.app
FRONTEND_ORIGIN_REGEX=https://.*\\.vercel\\.app

# LLM providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Render Key Value (connect the Render Key Value to the service and expose these variables)
REDIS_URL=
REDIS_PASSWORD=

# Render persistent disk
# Mount a persistent disk on the Render web service at /var/data/ai-firewall
RENDER_STORAGE_PATH=/var/data/ai-firewall

# BetterStack
BETTERSTACK_API_KEY=

# Enterprise integrations
CUSTOM_DOMAIN_TARGET=cname.vercel-dns.com

# Stripe test mode
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PROFESSIONAL=price_...
BILLING_ENFORCE=false
BILLING_ALLOW_PAST_DUE=false

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=
