# Supabase
# Frontend uses a VITE_SUPABASE_URL and publishable/anon key.
# Backend validates Supabase Auth bearer tokens with these server environment variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Upstash Redis
UPSTASH_REDIS_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_TOKEN=your-token

# Cloudflare R2
CLOUDFLARE_R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY=your-access-key
CLOUDFLARE_R2_SECRET_KEY=your-secret-key
CLOUDFLARE_R2_BUCKET=ai-firewall

# BetterStack
BETTERSTACK_API_KEY=your-betterstack-key

# LLM Providers
OPENAI_API_KEY=your-openai-key
ANTHROPIC_API_KEY=your-anthropic-key
